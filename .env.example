# Copy this file to .env in the project root, then run: docker compose up -d --build

NODE_ENV=production

# ── Database (used by the postgres service in docker-compose.yml) ────────────
# The backend's DATABASE_URL is built automatically from these in docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=projectmanagement

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRE=7d

# ── URLs ──────────────────────────────────────────────────────────────────────
# Set to the host:port where the frontend is accessed from the browser (docker-compose maps frontend to 8080)
FRONTEND_URL=http://localhost:8080
APP_URL=http://localhost:8080

# ── Host port bindings ────────────────────────────────────────────────────────
# Defaults (8080 web, 8000 API) are fine locally. On a shared server bind to
# localhost only and reverse-proxy with nginx, e.g.:
# FRONTEND_BIND=127.0.0.1:8090
# BACKEND_BIND=127.0.0.1:8091

# ── Cloudinary (file uploads) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP (email notifications) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
